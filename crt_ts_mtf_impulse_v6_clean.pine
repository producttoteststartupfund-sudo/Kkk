//@version=6
indicator("CRT + Turtle Soup MTF (Impulse + FVG Options) v6", overlay=true, max_lines_count=600, max_labels_count=600, max_boxes_count=120)

// Inputs
crtLen      = input.int(10, "CRT window (bars)", minval=3)
atrLen      = input.int(14, "ATR length")
atrMult     = input.float(1.2, "Max CRT height = ATR ×", minval=0.1, step=0.1)
usePct      = input.bool(false, "Use % of price instead of ATR")
maxPct      = input.float(0.60, "% height of price", step=0.05) / 100.0
needCloseIn = input.bool(true, "TS: require close back inside level")
validAfter  = input.int(300, "Bars after CRT update where sweeps valid", minval=1)

useH1  = input.bool(true,  "Show H1 CRT")
useH4  = input.bool(true,  "Show H4 CRT")
useD1  = input.bool(true,  "Show D1 CRT")
useW1  = input.bool(false, "Show W1 CRT")
useMN  = input.bool(false, "Show MN CRT")

dirTF          = input.string("240", "Impulse TF", options=["60","240","D","W","M"])
impAtrLen      = input.int(14,  "Impulse ATR length")
impMult        = input.float(1.5,"Impulse: TR > ATR ×", step=0.1)
impBodyFrac    = input.float(0.55,"Impulse: |body| / TR >", step=0.05)
hideOpp        = input.bool(true, "Hide opposite‑impulse signals")

confirmFVG     = input.bool(false, "Confirm with recent FVG")
fvgLookback    = input.int(10, "FVG lookback", minval=1)
confirmDisp    = input.bool(false, "Confirm with displacement")
dispAtrLen     = input.int(14, "Displacement ATR len")
dispMult       = input.float(1.2, "Displacement: TR > ATR ×", step=0.05)
dispBodyFrac   = input.float(0.55, "Displacement: |body|/TR >", step=0.05)

useSession  = input.bool(false, "Enable session filter")
sessionStr  = input.session("0700-1700", "Session HHMM‑HHMM")

showDash    = input.bool(true, "Show dashboard/table")
dashPos     = input.string("Top Right", "Dashboard position", options=["Top Left","Top Right","Bottom Left","Bottom Right"])

cH1 = color.new(color.rgb( 62,150,255), 0)
cH4 = color.new(color.rgb(147, 92,198), 0)
cD1 = color.new(color.rgb(  0,180,160), 0)
cW1 = color.new(color.rgb(255,145,  0), 0)
cMN = color.new(color.rgb(140,140,140), 0)

// Helpers
fLimitPrice() => usePct ? close * maxPct : ta.atr(atrLen) * atrMult

fCrtCandidate(_len) =>
    float _wh = ta.highest(high, _len)
    float _wl = ta.lowest(low, _len)
    bool  _ok = (_wh - _wl) <= fLimitPrice()
    [_ok ? _wh : na, _ok ? _wl : na]

fImpulseDir(_atrLen, _mult, _bodyFrac) =>
    float _tr   = ta.tr(true)
    float _atr2 = ta.atr(_atrLen)
    bool  _big  = _tr > _atr2 * _mult
    float _body = math.abs(close - open)
    bool  _strong = _body / _tr > _bodyFrac
    bool  _up   = _big and _strong and close > open
    bool  _down = _big and _strong and close < open
    var int _dir = 0
    _dir := _up ? 1 : _down ? -1 : _dir[1]
    _dir

fHasBullFVG(_lb) =>
    bool _now = low > high[2]
    not na(ta.barssince(_now)) and ta.barssince(_now) <= (_lb - 1)

fHasBearFVG(_lb) =>
    bool _now = high < low[2]
    not na(ta.barssince(_now)) and ta.barssince(_now) <= (_lb - 1)

fDispUp(_atrLen, _mult, _bodyFrac, _lb) =>
    float _tr = ta.tr(true)
    bool _ok = close > open and _tr > ta.atr(_atrLen) * _mult and math.abs(close - open) / _tr > _bodyFrac
    not na(ta.barssince(_ok)) and ta.barssince(_ok) <= (_lb - 1)

fDispDn(_atrLen, _mult, _bodyFrac, _lb) =>
    float _tr = ta.tr(true)
    bool _ok = close < open and _tr > ta.atr(_atrLen) * _mult and math.abs(close - open) / _tr > _bodyFrac
    not na(ta.barssince(_ok)) and ta.barssince(_ok) <= (_lb - 1)

bool inSess = not useSession or (time(timeframe.period, sessionStr) != 0)

getCrtOn(string tf) => request.security(syminfo.tickerid, tf, fCrtCandidate(crtLen), barmerge.gaps_off, barmerge.lookahead_off)

// Sticky CRT levels and timestamps
var float h1Hi = na, h1Lo = na
var float h4Hi = na, h4Lo = na
var float d1Hi = na, d1Lo = na
var float w1Hi = na, w1Lo = na
var float mnHi = na, mnLo = na

var int h1When = na, h4When = na, d1When = na, w1When = na, mnWhen = na

[float nH1, float nL1] = getCrtOn("60")
[float nH4, float nL4] = getCrtOn("240")
[float nD1, float nDL] = getCrtOn("D")
[float nW1, float nWL] = getCrtOn("W")
[float nMN, float nML] = getCrtOn("M")

if not na(nH1) and not na(nL1)
    h1Hi := nH1
    h1Lo := nL1
    h1When := bar_index
if not na(nH4) and not na(nL4)
    h4Hi := nH4
    h4Lo := nL4
    h4When := bar_index
if not na(nD1) and not na(nDL)
    d1Hi := nD1
    d1Lo := nDL
    d1When := bar_index
if not na(nW1) and not na(nWL)
    w1Hi := nW1
    w1Lo := nWL
    w1When := bar_index
if not na(nMN) and not na(nML)
    mnHi := nMN
    mnLo := nML
    mnWhen := bar_index

int impulseDir = request.security(syminfo.tickerid, dirTF, fImpulseDir(impAtrLen, impMult, impBodyFrac), barmerge.gaps_off, barmerge.lookahead_off)
bool isUpImpulse   = impulseDir == 1
bool isDownImpulse = impulseDir == -1

// Lines
var line h1HiLine = na, h1LoLine = na
var line h4HiLine = na, h4LoLine = na
var line d1HiLine = na, d1LoLine = na
var line w1HiLine = na, w1LoLine = na
var line mnHiLine = na, mnLoLine = na

fLine(line existing, float y, color col, int width) =>
    line ln = existing
    if na(ln)
        ln := line.new(bar_index, y, bar_index + 1, y, extend=extend.right, color=col, width=width)
    else
        line.set_y1(ln, y)
        line.set_y2(ln, y)
        line.set_color(ln, col)
        line.set_width(ln, width)
    ln

if useH1 and not na(h1Hi) and not na(h1Lo)
    h1HiLine := fLine(h1HiLine, h1Hi, cH1, 2)
    h1LoLine := fLine(h1LoLine, h1Lo, cH1, 2)
if useH4 and not na(h4Hi) and not na(h4Lo)
    h4HiLine := fLine(h4HiLine, h4Hi, cH4, 2)
    h4LoLine := fLine(h4LoLine, h4Lo, cH4, 2)
if useD1 and not na(d1Hi) and not na(d1Lo)
    d1HiLine := fLine(d1HiLine, d1Hi, cD1, 2)
    d1LoLine := fLine(d1LoLine, d1Lo, cD1, 2)
if useW1 and not na(w1Hi) and not na(w1Lo)
    w1HiLine := fLine(w1HiLine, w1Hi, cW1, 2)
    w1LoLine := fLine(w1LoLine, w1Lo, cW1, 2)
if useMN and not na(mnHi) and not na(mnLo)
    mnHiLine := fLine(mnHiLine, mnHi, cMN, 2)
    mnLoLine := fLine(mnLoLine, mnLo, cMN, 2)

tsLong(float level)  => low < level  and (not needCloseIn or close > level)
tsShort(float level) => high > level and (not needCloseIn or close < level)

bool dirOKLong  = isUpImpulse   or not hideOpp
bool dirOKShort = isDownImpulse or not hideOpp
bool timeOK     = inSess

bool bullFvgRecent = not confirmFVG or fHasBullFVG(fvgLookback)
bool bearFvgRecent = not confirmFVG or fHasBearFVG(fvgLookback)
bool bullDispOK    = not confirmDisp or fDispUp(dispAtrLen, dispMult, dispBodyFrac, 5)
bool bearDispOK    = not confirmDisp or fDispDn(dispAtrLen, dispMult, dispBodyFrac, 5)

bool extraOKLong  = bullFvgRecent and bullDispOK
bool extraOKShort = bearFvgRecent and bearDispOK

within(int whenIdx) => not na(whenIdx) and (bar_index - whenIdx) <= validAfter

// Signals per TF
bool tsL_h1 = useH1 and not na(h1Lo) and within(h1When) and tsLong(h1Lo)  and dirOKLong  and timeOK and extraOKLong
bool tsS_h1 = useH1 and not na(h1Hi) and within(h1When) and tsShort(h1Hi) and dirOKShort and timeOK and extraOKShort
plotshape(tsL_h1, title="TS Long H1",  style=shape.triangleup,   color=cH1, location=location.belowbar, text="TS H1")
plotshape(tsS_h1, title="TS Short H1", style=shape.triangledown, color=cH1, location=location.abovebar, text="TS H1")

bool tsL_h4 = useH4 and not na(h4Lo) and within(h4When) and tsLong(h4Lo)  and dirOKLong  and timeOK and extraOKLong
bool tsS_h4 = useH4 and not na(h4Hi) and within(h4When) and tsShort(h4Hi) and dirOKShort and timeOK and extraOKShort
plotshape(tsL_h4, title="TS Long H4",  style=shape.triangleup,   color=cH4, location=location.belowbar, text="TS H4")
plotshape(tsS_h4, title="TS Short H4", style=shape.triangledown, color=cH4, location=location.abovebar, text="TS H4")

bool tsL_d1 = useD1 and not na(d1Lo) and within(d1When) and tsLong(d1Lo)  and dirOKLong  and timeOK and extraOKLong
bool tsS_d1 = useD1 and not na(d1Hi) and within(d1When) and tsShort(d1Hi) and dirOKShort and timeOK and extraOKShort
plotshape(tsL_d1, title="TS Long D1",  style=shape.triangleup,   color=cD1, location=location.belowbar, text="TS D1")
plotshape(tsS_d1, title="TS Short D1", style=shape.triangledown, color=cD1, location=location.abovebar, text="TS D1")

bool tsL_w1 = useW1 and not na(w1Lo) and within(w1When) and tsLong(w1Lo)  and dirOKLong  and timeOK and extraOKLong
bool tsS_w1 = useW1 and not na(w1Hi) and within(w1When) and tsShort(w1Hi) and dirOKShort and timeOK and extraOKShort
plotshape(tsL_w1, title="TS Long W1",  style=shape.triangleup,   color=cW1, location=location.belowbar, text="TS W1")
plotshape(tsS_w1, title="TS Short W1", style=shape.triangledown, color=cW1, location=location.abovebar, text="TS W1")

bool tsL_mn = useMN and not na(mnLo) and within(mnWhen) and tsLong(mnLo)  and dirOKLong  and timeOK and extraOKLong
bool tsS_mn = useMN and not na(mnHi) and within(mnWhen) and tsShort(mnHi) and dirOKShort and timeOK and extraOKShort
plotshape(tsL_mn, title="TS Long MN",  style=shape.triangleup,   color=cMN, location=location.belowbar, text="TS MN")
plotshape(tsS_mn, title="TS Short MN", style=shape.triangledown, color=cMN, location=location.abovebar, text="TS MN")

alertcondition(tsL_h1 or tsL_h4 or tsL_d1 or tsL_w1 or tsL_mn, "Turtle Soup LONG (aligned)",  "TS Long aligned with impulse and confirmations")
alertcondition(tsS_h1 or tsS_h4 or tsS_d1 or tsS_w1 or tsS_mn, "Turtle Soup SHORT (aligned)", "TS Short aligned with impulse and confirmations")

// Dashboard
fPos(p) => p == "Top Left" ? position.top_left : p == "Top Right" ? position.top_right : p == "Bottom Left" ? position.bottom_left : position.bottom_right

var table dash = na
if showDash and barstate.islast
    if na(dash)
        dash := table.new(fPos(dashPos), 4, 8, frame_color=color.new(color.black, 0), frame_width=1, border_color=color.new(color.gray, 70))
    table.cell(dash, 0, 0, "TF",        text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 1, 0, "CRT High",  text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 2, 0, "CRT Low",   text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 3, 0, "Signal",    text_color=color.white, bgcolor=color.new(color.black, 0))

    fRow(int r, string tfName, float hi, float lo, color col, bool tsL, bool tsS) =>
        table.cell(dash, 0, r, tfName, text_color=color.white, bgcolor=color.new(col, 85), text_halign=text.align_left)
        table.cell(dash, 1, r, na(hi) ? "na" : str.tostring(hi), text_color=color.white, bgcolor=color.new(col, 92), text_halign=text.align_right)
        table.cell(dash, 2, r, na(lo) ? "na" : str.tostring(lo), text_color=color.white, bgcolor=color.new(col, 92), text_halign=text.align_right)
        string _sig = tsL ? "TS Long" : tsS ? "TS Short" : ""
        table.cell(dash, 3, r, _sig, text_color=color.white, bgcolor=color.new(col, 92), text_halign=text.align_left)

    int row = 1
    if useH1
        fRow(row, "H1", h1Hi, h1Lo, cH1, tsL_h1, tsS_h1)
        row += 1
    if useH4
        fRow(row, "H4", h4Hi, h4Lo, cH4, tsL_h4, tsS_h4)
        row += 1
    if useD1
        fRow(row, "D1", d1Hi, d1Lo, cD1, tsL_d1, tsS_d1)
        row += 1
    if useW1
        fRow(row, "W1", w1Hi, w1Lo, cW1, tsL_w1, tsS_w1)
        row += 1
    if useMN
        fRow(row, "MN", mnHi, mnLo, cMN, tsL_mn, tsS_mn)
        row += 1

// Impulse banner
var label impulseLbl = na
if barstate.islast
    string txt = isUpImpulse ? "Impulse: UP (" + dirTF + ")" : isDownImpulse ? "Impulse: DOWN (" + dirTF + ")" : "Impulse: None (" + dirTF + ")"
    if na(impulseLbl)
        impulseLbl := label.new(bar_index, close, txt, xloc=xloc.bar_index, yloc=yloc.price, textcolor=color.white, style=label.style_label_left, color=color.new(color.black, 0))
    else
        label.set_text(impulseLbl, txt)
        label.set_x(impulseLbl, bar_index)
        label.set_color(impulseLbl, isUpImpulse ? color.new(color.teal, 0) : isDownImpulse ? color.new(color.red, 0) : color.new(color.gray, 0))

