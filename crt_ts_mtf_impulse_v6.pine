//@version=6
indicator("CRT + Turtle Soup MTF (Impulse + FVG Options)", overlay=true, max_lines_count=600, max_labels_count=600, max_boxes_count=120)

// ========================= Inputs =========================
// CRT window definition
crtLen      = input.int(10, "CRT window (bars)", minval=3)
atrLen      = input.int(14, "ATR length")
atrMult     = input.float(1.2, "Max CRT height = ATR ×", minval=0.1, step=0.1)
usePct      = input.bool(false, "Use % of price instead of ATR")
maxPct      = input.float(0.60, "% height of price", step=0.05) / 100.0
needCloseIn = input.bool(true, "TS: require close back inside level")

// Timeframes to show CRT from
useH1  = input.bool(true,  "Show H1 CRT")
useH4  = input.bool(true,  "Show H4 CRT")
useD1  = input.bool(true,  "Show D1 CRT")
useW1  = input.bool(false, "Show W1 CRT")
useMN  = input.bool(false, "Show MN CRT")

// Impulse filter (direction correctness)
dirTF          = input.string("240", "Impulse filter timeframe", options=["60","240","D","W","M"])
impAtrLen      = input.int(14,  "Impulse ATR length")
impMult        = input.float(1.5,"Impulse: TR must be > ATR ×", step=0.1)
impBodyFrac    = input.float(0.55,"Impulse: |body| / TR >", step=0.05)
hideOppSignals = input.bool(true, "Hide signals against impulse direction")

// Optional confirmations
confirmFVG           = input.bool(false, "Confirm with recent FVG (same direction)")
fvgLookback          = input.int(10, "FVG lookback (bars)", minval=1)
confirmDisplacement  = input.bool(false, "Confirm with displacement on chart TF")
dispAtrLen           = input.int(14, "Displacement ATR length")
dispMult             = input.float(1.2, "Displacement: TR > ATR ×", step=0.05)
dispBodyFrac         = input.float(0.55, "Displacement: |body|/TR >", step=0.05)

// Session filter
useSession  = input.bool(false, "Enable session filter (exchange time)")
sessionStr  = input.session("0700-1700", "Session HHMM-HHMM")

// Dashboard
showDashboard = input.bool(true, "Show dashboard/table")
dashPos       = input.string("Top Right", "Dashboard position", options=["Top Left","Top Right","Bottom Left","Bottom Right"])
dashScale     = input.float(1.0, "Dashboard scale", step=0.1, minval=0.5, maxval=2.0)

// Colors per TF
cH1 = color.new(color.rgb( 62,150,255), 0)
cH4 = color.new(color.rgb(147, 92,198), 0)
cD1 = color.new(color.rgb(  0,180,160), 0)
cW1 = color.new(color.rgb(255,145,  0), 0)
cMN = color.new(color.rgb(140,140,140), 0)

// ========================= Helpers =========================
fCrtCore(_len, _atrLen, _atrMult, _usePct, _maxPct) =>
    _atr   = ta.atr(_atrLen)
    _limit = _usePct ? close * _maxPct : _atr * _atrMult
    _wh = ta.highest(high, _len)
    _wl = ta.lowest(low, _len)
    _in = (_wh - _wl) <= _limit

    float _boxHi = na
    float _boxLo = na
    float _crtHi = na
    float _crtLo = na
    if _in
        if not _in[1]
            _boxHi := high
            _boxLo := low
        else
            _boxHi := math.max(_boxHi, high)
            _boxLo := math.min(_boxLo, low)
    if not _in and _in[1]
        _crtHi := _boxHi
        _crtLo := _boxLo
    [_crtHi, _crtLo]

fSticky(newVal, prevVal) => not na(newVal) ? newVal : prevVal

// Impulse direction on a TF: +1 up, -1 down, 0 none
fImpulseDir(_atrLen, _mult, _bodyFrac) =>
    _tr   = ta.tr(true)
    _atr2 = ta.atr(_atrLen)
    _big  = _tr > _atr2 * _mult
    _body = math.abs(close - open)
    _strong = _body / _tr > _bodyFrac
    _up   = _big and _strong and close > open
    _down = _big and _strong and close < open
    var int _dir = 0
    _dir := _up ?  1 : _down ? -1 : _dir[1]
    _dir

// FVG detection (classic 3-candle)
fHasBullFVG(_lb) =>
    _now = low > high[2]
    not na(ta.barssince(_now)) and ta.barssince(_now) <= (_lb - 1)

fHasBearFVG(_lb) =>
    _now = high < low[2]
    not na(ta.barssince(_now)) and ta.barssince(_now) <= (_lb - 1)

// Displacement detection on chart TF
fDispUp(_atrLen, _mult, _bodyFrac, _lb) =>
    _tr = ta.tr(true)
    _ok = close > open and _tr > ta.atr(_atrLen) * _mult and math.abs(close - open) / _tr > _bodyFrac
    not na(ta.barssince(_ok)) and ta.barssince(_ok) <= (_lb - 1)

fDispDn(_atrLen, _mult, _bodyFrac, _lb) =>
    _tr = ta.tr(true)
    _ok = close < open and _tr > ta.atr(_atrLen) * _mult and math.abs(close - open) / _tr > _bodyFrac
    not na(ta.barssince(_ok)) and ta.barssince(_ok) <= (_lb - 1)

// Session gate
inSess = not useSession or (time(timeframe.period, sessionStr) != 0)

// ========================= MTF CRT Levels =========================
getLevels(tf) =>
    request.security(syminfo.tickerid, tf, fCrtCore(crtLen, atrLen, atrMult, usePct, maxPct), barmerge.gaps_off, barmerge.lookahead_off)

var float h1Hi = na
var float h1Lo = na
var float h4Hi = na
var float h4Lo = na
var float d1Hi = na
var float d1Lo = na
var float w1Hi = na
var float w1Lo = na
var float mnHi = na
var float mnLo = na

float h1HiNew = na
float h1LoNew = na
float h4HiNew = na
float h4LoNew = na
float d1HiNew = na
float d1LoNew = na
float w1HiNew = na
float w1LoNew = na
float mnHiNew = na
float mnLoNew = na

float tH1 = na
float tL1 = na
float tH4 = na
float tL4 = na
float tD1 = na
float tDL = na
float tW1 = na
float tWL = na
float tMN = na
float tML = na

[tH1, tL1] = getLevels("60")
[tH4, tL4] = getLevels("240")
[tD1, tDL] = getLevels("D")
[tW1, tWL] = getLevels("W")
[tMN, tML] = getLevels("M")

h1HiNew := tH1
h1LoNew := tL1
h4HiNew := tH4
h4LoNew := tL4
d1HiNew := tD1
d1LoNew := tDL
w1HiNew := tW1
w1LoNew := tWL
mnHiNew := tMN
mnLoNew := tML

h1Hi := fSticky(h1HiNew, h1Hi)
h1Lo := fSticky(h1LoNew, h1Lo)
h4Hi := fSticky(h4HiNew, h4Hi)
h4Lo := fSticky(h4LoNew, h4Lo)
d1Hi := fSticky(d1HiNew, d1Hi)
d1Lo := fSticky(d1LoNew, d1Lo)
w1Hi := fSticky(w1HiNew, w1Hi)
w1Lo := fSticky(w1LoNew, w1Lo)
mnHi := fSticky(mnHiNew, mnHi)
mnLo := fSticky(mnLoNew, mnLo)

// ========================= Impulse Direction =========================
int impulseDir = request.security(syminfo.tickerid, dirTF, fImpulseDir(impAtrLen, impMult, impBodyFrac), barmerge.gaps_off, barmerge.lookahead_off)
isUpImpulse   = impulseDir == 1
isDownImpulse = impulseDir == -1

// ========================= Draw CRT Lines =========================
var line h1HiLine = na, h1LoLine = na
var line h4HiLine = na, h4LoLine = na
var line d1HiLine = na, d1LoLine = na
var line w1HiLine = na, w1LoLine = na
var line mnHiLine = na, mnLoLine = na

fSetLine(ln, y, col, width) =>
    if na(ln)
        ln := line.new(bar_index, y, bar_index + 1, y, extend=extend.right, color=col, width=width)
    else
        line.set_y1(ln, y)
        line.set_y2(ln, y)
        line.set_color(ln, col)
        line.set_width(ln, width)
    ln

if useH1 and not na(h1Hi) and not na(h1Lo)
    h1HiLine := fSetLine(h1HiLine, h1Hi, cH1, 2)
    h1LoLine := fSetLine(h1LoLine, h1Lo, cH1, 2)

if useH4 and not na(h4Hi) and not na(h4Lo)
    h4HiLine := fSetLine(h4HiLine, h4Hi, cH4, 2)
    h4LoLine := fSetLine(h4LoLine, h4Lo, cH4, 2)

if useD1 and not na(d1Hi) and not na(d1Lo)
    d1HiLine := fSetLine(d1HiLine, d1Hi, cD1, 2)
    d1LoLine := fSetLine(d1LoLine, d1Lo, cD1, 2)

if useW1 and not na(w1Hi) and not na(w1Lo)
    w1HiLine := fSetLine(w1HiLine, w1Hi, cW1, 2)
    w1LoLine := fSetLine(w1LoLine, w1Lo, cW1, 2)

if useMN and not na(mnHi) and not na(mnLo)
    mnHiLine := fSetLine(mnHiLine, mnHi, cMN, 2)
    mnLoLine := fSetLine(mnLoLine, mnLo, cMN, 2)

// ========================= Signal Logic =========================
fTSLong(level)  => low < level  and (not needCloseIn or close > level)
fTSShort(level) => high > level and (not needCloseIn or close < level)

dirOKLong  = isUpImpulse   or not hideOppSignals
dirOKShort = isDownImpulse or not hideOppSignals
timeOK     = inSess

// Optional confirmations on chart TF
bullFvgRecent = not confirmFVG or fHasBullFVG(fvgLookback)
bearFvgRecent = not confirmFVG or fHasBearFVG(fvgLookback)
bullDispOK    = not confirmDisplacement or fDispUp(dispAtrLen, dispMult, dispBodyFrac, 5)
bearDispOK    = not confirmDisplacement or fDispDn(dispAtrLen, dispMult, dispBodyFrac, 5)

extraOKLong  = bullFvgRecent and bullDispOK
extraOKShort = bearFvgRecent and bearDispOK

// H1
tsL_h1 = useH1 and not na(h1Lo) and fTSLong(h1Lo)  and dirOKLong  and timeOK and extraOKLong
tsS_h1 = useH1 and not na(h1Hi) and fTSShort(h1Hi) and dirOKShort and timeOK and extraOKShort
plotshape(tsL_h1, title="TS Long H1",  style=shape.triangleup,   color=cH1, location=location.belowbar, text="TS H1")
plotshape(tsS_h1, title="TS Short H1", style=shape.triangledown, color=cH1, location=location.abovebar, text="TS H1")

// H4
tsL_h4 = useH4 and not na(h4Lo) and fTSLong(h4Lo)  and dirOKLong  and timeOK and extraOKLong
tsS_h4 = useH4 and not na(h4Hi) and fTSShort(h4Hi) and dirOKShort and timeOK and extraOKShort
plotshape(tsL_h4, title="TS Long H4",  style=shape.triangleup,   color=cH4, location=location.belowbar, text="TS H4")
plotshape(tsS_h4, title="TS Short H4", style=shape.triangledown, color=cH4, location=location.abovebar, text="TS H4")

// D1
tsL_d1 = useD1 and not na(d1Lo) and fTSLong(d1Lo)  and dirOKLong  and timeOK and extraOKLong
tsS_d1 = useD1 and not na(d1Hi) and fTSShort(d1Hi) and dirOKShort and timeOK and extraOKShort
plotshape(tsL_d1, title="TS Long D1",  style=shape.triangleup,   color=cD1, location=location.belowbar, text="TS D1")
plotshape(tsS_d1, title="TS Short D1", style=shape.triangledown, color=cD1, location=location.abovebar, text="TS D1")

// W1
tsL_w1 = useW1 and not na(w1Lo) and fTSLong(w1Lo)  and dirOKLong  and timeOK and extraOKLong
tsS_w1 = useW1 and not na(w1Hi) and fTSShort(w1Hi) and dirOKShort and timeOK and extraOKShort
plotshape(tsL_w1, title="TS Long W1",  style=shape.triangleup,   color=cW1, location=location.belowbar, text="TS W1")
plotshape(tsS_w1, title="TS Short W1", style=shape.triangledown, color=cW1, location=location.abovebar, text="TS W1")

// MN
tsL_mn = useMN and not na(mnLo) and fTSLong(mnLo)  and dirOKLong  and timeOK and extraOKLong
tsS_mn = useMN and not na(mnHi) and fTSShort(mnHi) and dirOKShort and timeOK and extraOKShort
plotshape(tsL_mn, title="TS Long MN",  style=shape.triangleup,   color=cMN, location=location.belowbar, text="TS MN")
plotshape(tsS_mn, title="TS Short MN", style=shape.triangledown, color=cMN, location=location.abovebar, text="TS MN")

// Alerts
alertcondition(tsL_h1 or tsL_h4 or tsL_d1 or tsL_w1 or tsL_mn, "Turtle Soup LONG (aligned)",  "TS Long aligned with impulse and confirmations")
alertcondition(tsS_h1 or tsS_h4 or tsS_d1 or tsS_w1 or tsS_mn, "Turtle Soup SHORT (aligned)", "TS Short aligned with impulse and confirmations")

// ========================= Dashboard =========================
fPos(p) => p == "Top Left" ? position.top_left : p == "Top Right" ? position.top_right : p == "Bottom Left" ? position.bottom_left : position.bottom_right

// table row helper (global scope)
fRow(tbl, r, tfName, hi, lo, col, tsLong, tsShort) =>
    table.cell(tbl, 0, r, tfName, text_color=color.white, bgcolor=color.new(col, 85), text_halign=text.align_left, text_size=size.normal)
    table.cell(tbl, 1, r, na(hi) ? "na" : str.tostring(hi), text_color=color.white, bgcolor=color.new(col, 92), text_halign=text.align_right, text_size=size.normal)
    table.cell(tbl, 2, r, na(lo) ? "na" : str.tostring(lo), text_color=color.white, bgcolor=color.new(col, 92), text_halign=text.align_right, text_size=size.normal)
    _sig = tsLong ? "TS Long" : tsShort ? "TS Short" : ""
    table.cell(tbl, 3, r, _sig, text_color=color.white, bgcolor=color.new(col, 92), text_halign=text.align_left, text_size=size.normal)

var table dash = na
if showDashboard and barstate.islast
    if na(dash)
        dash := table.new(fPos(dashPos), 4, 8, frame_color=color.new(color.black, 0), frame_width=1, border_color=color.new(color.gray, 70))
    // Headers
    table.cell(dash, 0, 0, "TF",        text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 1, 0, "CRT High",  text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 2, 0, "CRT Low",   text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 3, 0, "Signal",    text_color=color.white, bgcolor=color.new(color.black, 0))

    row = 1
    if useH1
        fRow(dash, row, "H1", h1Hi, h1Lo, cH1, tsL_h1, tsS_h1)
        row += 1
    if useH4
        fRow(dash, row, "H4", h4Hi, h4Lo, cH4, tsL_h4, tsS_h4)
        row += 1
    if useD1
        fRow(dash, row, "D1", d1Hi, d1Lo, cD1, tsL_d1, tsS_d1)
        row += 1
    if useW1
        fRow(dash, row, "W1", w1Hi, w1Lo, cW1, tsL_w1, tsS_w1)
        row += 1
    if useMN
        fRow(dash, row, "MN", mnHi, mnLo, cMN, tsL_mn, tsS_mn)
        row += 1

// Impulse banner
var label impulseLbl = na
if barstate.islast
    string txt = isUpImpulse ? "Impulse: UP (" + dirTF + ")" : isDownImpulse ? "Impulse: DOWN (" + dirTF + ")" : "Impulse: None (" + dirTF + ")"
    if na(impulseLbl)
        impulseLbl := label.new(bar_index, close, txt, xloc=xloc.bar_index, yloc=yloc.price, textcolor=color.white, style=label.style_label_left, color=color.new(color.black, 0))
    else
        label.set_text(impulseLbl, txt)
        label.set_x(impulseLbl, bar_index)
        label.set_color(impulseLbl, isUpImpulse ? color.new(color.teal, 0) : isDownImpulse ? color.new(color.red, 0) : color.new(color.gray, 0))

